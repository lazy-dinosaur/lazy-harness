#!/usr/bin/env bash
# .lazy-harness/bin/lazy — per-host lazy-harness CLI
#
# This file lives inside each host's .lazy-harness/ copy (untracked from the
# host's perspective; tracked in the framework master repo). Hooks and the user
# launcher (~/.local/bin/lazy) call this entry point.
#
# Subcommands delegate to scripts/ inside the same .lazy-harness/ tree, which
# means every host runs ITS OWN test/doctor/sync logic — never another host's.
#
# Design notes:
#   - This script must be relocatable: it resolves paths from its own location,
#     not from $PWD. A user can run `.lazy-harness/bin/lazy test` from any
#     subdirectory of the host.
#   - Subcommands are minimal on purpose; richer UX (interview, config) is the
#     responsibility of the scripts/ files, not this dispatcher.

set -euo pipefail

# Resolve the .lazy-harness/ root from this script's location.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAZY_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LAZY_INVOCATION_CWD="$(pwd)"
export LAZY_INVOCATION_CWD

# Resolve the host root from an explicit harness boundary first. Hooks set
# LAZY_HOST_ROOT before clearing Git's hook environment so downstream validators
# cannot accidentally inherit GIT_DIR/GIT_WORK_TREE into their temp fixtures.
if [ -n "${LAZY_HOST_ROOT:-}" ] && [ -d "$LAZY_HOST_ROOT/.lazy-harness" ]; then
  HOST_ROOT="$(cd "$LAZY_HOST_ROOT" && pwd)"
else
  # Resolve the host root from the caller's git worktree. This matters when
  # .lazy-harness is symlinked into a secondary worktree: the script file may
  # physically live in the primary checkout, but the command must validate the
  # worktree where the user invoked it.
  CALLER_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$CALLER_ROOT" ] && [ -d "$CALLER_ROOT/.lazy-harness" ]; then
    HOST_ROOT="$CALLER_ROOT"
  else
    HOST_ROOT="$(cd "$LAZY_ROOT/.." && pwd)"
  fi
fi
export LAZY_HOST_ROOT="$HOST_ROOT"

SCRIPTS="$LAZY_ROOT/scripts"

# All subcommands are invoked from the host root so that relative paths inside
# self-test.py / doctor.py / lazy-init.ts behave consistently.
cd "$HOST_ROOT"

usage() {
  cat <<'USAGE'
Usage: lazy <command> [options]

Commands:
  check [--files F1,F2,...] [--all] [--format=md|json]
                                Fast changed-file static validation, not full regression
  validate [--plan=fast|standard|release] [--max-seconds=N] [--dry-run]
                                Run a bounded validation plan with release opt-in guard
  test [--scope=auto|framework|host] [--light]
                                Run framework self-test (default: auto). --light skips measured-heavy checks for the pre-commit gate; pre-push runs full (ADR 0016).
  doctor [--profile=smoke|full] Run framework health check (default: smoke)
  prompt-budget [--format=json|md]
                                Measure prompt surface line/token budgets
  init [--target=DIR] [--dry-run]
                                Bootstrap .lazy-harness/ in a new host; prints Pi/OMP activation command
  agent activate [--target=DIR] [--dry-run]
                                Create project-local Pi/OMP activation prompt files
  sync [--dry-run] [--force] [--skip-knowledge-seeds]
                                Refresh framework body (Category A); optionally leave knowledge JSONL untouched
  update [--dry-run] [--force]  Fetch latest lazy-harness source and sync this host
  pi install|remove|list|smoke|doctor
                                Manage lazy-harness-pi install/list/smoke wrappers for official Pi
  omp install|remove|list|smoke|doctor
                                Manage lazy-harness-pi plugin wrappers for Oh My Pi / OMP
  jcode install|remove|smoke|doctor|trust|untrust|trusted-roots
                                Manage official Jcode hooks; repository scripts run only for explicitly trusted lazy roots
  capability add|list|resolve|candidates|audit
                                Add, list, resolve, suggest, or audit registered capabilities
  architecture inspect|plan|apply
                                Inspect, plan, and exactly confirm host architecture maps
  policy list|audit|explain|resolve|render-rulebook|upsert|retire-readiness|block-readiness
                                List, audit, explain, resolve, render generated views, upsert typed behavior policies, or preflight rulebook/block readiness
  rules list|resolve|audit
                                Compatibility/explain view over rulebook entries; policy semantics live in policies.json
  affected [--files F1,F2,...]  Run affected tests for given files
  impl-map [--format=markdown|json|agent-prompt]
                                Audit ADR 0030 Implementation maps; reports advisory status drift (planned-but-files-present, verified-but-files-missing)
  map --overview [--complete] [--format=json|md] [--limit=N] [--fresh]
                                Show project map; --complete lists every record (untruncated lean discovery index)
  map <feature-id|record-path|graph-id|source-path> [--format=json|md] [--limit=N] [--fresh]
                                Show drill-down candidates for a concrete map node copied from overview
  retrieval-audit <term-or-file> [--format=json|md] [--limit=N]
                                Audit lazy map/record-index coverage gaps and concrete map/read candidates
  retrieval-workflow-benchmark [--format=json|md] [--limit=N] [--queries=q1,q2]
                                Measure post-overview map/retrieval-audit workflow costs
  record-index [--write] [--format=json|md]
                                Build deterministic generated record/source index cache
  record-decision [--message "..."] [--format=json|md]
                                Produce post-turn Record Decision Packet from explicit evidence flags
  record-audit [--format=json|md] [--source=DIR]
                                Summarize accumulated host records and quality signals
  graph-hygiene [--format=json|md] [--fail-on-issues] [--migration-plan]
                                Lint knowledge graph IDs/paths (supersession-aware duplicate policy); --migration-plan adds read-only legacy-row/removed-ref/record-jcode/missing-path proposals
  record-lint [--format=json|md] [--fail-on-issues]
                                Validate canonical records: Rule digest format + broken record refs
  record-structure-audit [--format=json|md]
                                Read-only W1 baseline: surface-term coverage, reachability/orphans, link density, graph schema census
  backlink-index [--root=DIR]   Rebuild generated/backlink-index.json (derived backlinks from forward links + graph.jsonl)
  retro feedback|report|resolve
                                Retro learning loop MVP: classified feedback (L1/L2/L3), KPT report + 3-repeat pattern candidates, resolve after user-gated promotion
  regression add|lint        Register (validated, canonical) or lint Fix-commit regression entries
                                add --sha <40hex> --description <t> --test <path> --repro <t> | lint [--fail-on-issues]
  gate-state list|clear-stale   Inspect or clear stale runtime open-gates state
  hook-timings [--format=json|md] [--limit=N] [--since=ISO] [--all-sessions]
                                Summarize response.completed hook timing measurements
  lifecycle-check [--format=json|md] [--sandbox]
                                Run shadow response.completed lifecycle helper orchestrator
  lifecycle-compare-summary [--format=json|md] [--log=PATH] [--since=ISO]
                                Summarize response.completed compare-mode JSONL rows
  lifecycle-parity [--format=json|md] [--fail-on-mismatch]
                                Compare legacy response hook with lifecycle-check shadow fixtures
  lifecycle-fixture inspect|append|list
                                Capture safe real payload fixture candidates
  version                       Print framework version + host path
  help                          Show this help

Subcommands run against the .lazy-harness/ at:
  HOST_ROOT (resolved): see `lazy version`
USAGE
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  check)
    exec python3 "$SCRIPTS/lazy-check.py" "$@"
    ;;
  validate)
    exec python3 "$SCRIPTS/validation-governor.py" "$@"
    ;;
  test)
    exec python3 "$SCRIPTS/self-test.py" "$@"
    ;;
  doctor)
    # Default profile = smoke. Pass-through any user flags.
    profile="smoke"
    args=()
    for a in "$@"; do
      case "$a" in
        --profile=*) profile="${a#--profile=}" ;;
        *) args+=("$a") ;;
      esac
    done
    exec python3 "$SCRIPTS/doctor.py" --profile "$profile" "${args[@]}"
    ;;
  prompt-budget)
    exec python3 "$SCRIPTS/prompt-budget.py" --root "$HOST_ROOT" "$@"
    ;;
  init)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy init: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    exec bun "$SCRIPTS/lazy-init.ts" "$@"
    ;;
  sync)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy sync: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    exec bun "$SCRIPTS/lazy-sync.ts" "$@"
    ;;
  update)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy update: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    exec bun "$SCRIPTS/lazy-update.ts" "$@"
    ;;
  agent)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy agent: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    subcmd="${1:-help}"
    shift || true
    case "$subcmd" in
      activate)
        exec bun "$SCRIPTS/agent-activate.ts" "$@"
        ;;
      help|-h|--help)
        echo "Usage: lazy agent activate [--target=DIR] [--dry-run] [--format=md|json]"
        exit 0
        ;;
      *)
        echo "Unknown lazy agent command: $subcmd" >&2
        echo "Usage: lazy agent activate [--target=DIR] [--dry-run] [--format=md|json]" >&2
        exit 2
        ;;
    esac
    ;;
  pi)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy pi: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    LAZY_AGENT_RUNTIME="pi" LAZY_PI_TARGET_REPO="$LAZY_INVOCATION_CWD" exec bun "$SCRIPTS/pi-package.ts" "$@"
    ;;
  omp)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy omp: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    LAZY_AGENT_RUNTIME="omp" LAZY_OMP_TARGET_REPO="$LAZY_INVOCATION_CWD" exec bun "$SCRIPTS/pi-package.ts" "$@"
    ;;
  jcode)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy jcode: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    subcmd="${1:-help}"
    shift || true
    case "$subcmd" in
      hook)
        event="${1:-}"
        [ -n "$event" ] || { echo "Usage: lazy jcode hook <event>" >&2; exit 2; }
        shift || true
        exec bun "$SCRIPTS/jcode-adapter.ts" "$event" "$@"
        ;;
      install|remove|smoke|doctor|trust|untrust|trusted-roots)
        exec bun "$SCRIPTS/jcode-package.ts" "$subcmd" "$@"
        ;;
      help|-h|--help)
        exec bun "$SCRIPTS/jcode-package.ts" --help
        ;;
      *)
        echo "Unknown lazy jcode command: $subcmd" >&2
        echo "Usage: lazy jcode install|remove|smoke|doctor|trust|untrust|trusted-roots" >&2
        exit 2
        ;;
    esac
    ;;
  architecture)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy architecture: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    exec bun "$SCRIPTS/architecture-profile.ts" "$@"
    ;;
  capability)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy capability: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    exec bun "$SCRIPTS/capability.ts" "$@"
    ;;
  policy)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy policy: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    exec bun "$SCRIPTS/policy.ts" "$@"
    ;;
  rules)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy rules: bun not found on PATH. Install bun first: https://bun.sh" >&2
      exit 127
    fi
    exec bun "$SCRIPTS/rulebook.ts" "$@"
    ;;
  affected)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy affected: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/affected-test-runner.ts" "$@"
    ;;
  impl-map)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy impl-map: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/implementation-map-audit.ts" "$@"
    ;;
  map)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy map: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/record-map.ts" --root "$HOST_ROOT" "$@"
    ;;
  record-index)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy record-index: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/record-index.ts" --root "$HOST_ROOT" "$@"
    ;;
  retrieval-audit)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy retrieval-audit: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/retrieval-coverage-audit.ts" --root "$HOST_ROOT" "$@"
    ;;
  retrieval-workflow-benchmark)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy retrieval-workflow-benchmark: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/retrieval-workflow-benchmark.ts" --root "$HOST_ROOT" "$@"
    ;;
  record-decision)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy record-decision: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/record-decision-broker.ts" --root "$HOST_ROOT" "$@"
    ;;
  record-audit)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy record-audit: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/record-audit.ts" "$@"
    ;;
  graph-hygiene)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy graph-hygiene: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/graph-hygiene.ts" "$@"
    ;;
  record-lint)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy record-lint: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/record-lint.ts" "$@"
    ;;
  record-structure-audit)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy record-structure-audit: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/record-structure-audit.ts" "$@"
    ;;
  backlink-index)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy backlink-index: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/backlink-index.ts" "$@"
    ;;
  retro)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy retro: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/retro.ts" "$@"
    ;;
  regression)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy regression: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/regression.ts" "$@"
    ;;
  gate-state)
    if ! command -v bun >/dev/null 2>&1; then
      echo "lazy gate-state: bun not found on PATH." >&2
      exit 127
    fi
    exec bun "$SCRIPTS/gate-state.ts" "$@"
    ;;
  hook-timings)
    exec python3 "$SCRIPTS/hook-timing-summary.py" "$@"
    ;;
  lifecycle-check)
    exec python3 "$SCRIPTS/lifecycle-check.py" "$@"
    ;;
  lifecycle-compare-summary)
    exec python3 "$SCRIPTS/lifecycle-compare-summary.py" "$@"
    ;;
  lifecycle-parity)
    exec python3 "$SCRIPTS/lifecycle-parity-runner.py" "$@"
    ;;
  lifecycle-fixture)
    exec python3 "$SCRIPTS/lifecycle-fixture-intake.py" "$@"
    ;;
  version)
    echo "lazy-harness CLI"
    echo "  host_root:  $HOST_ROOT"
    echo "  lazy_root:  $LAZY_ROOT"
    if [ -f "$LAZY_ROOT/framework/framework-contract.md" ]; then
      # Capture the first line that mentions a version like "v1.4" anywhere.
      ver=$(grep -m1 -oE 'v[0-9]+\.[0-9]+(\.[0-9]+)?' "$LAZY_ROOT/framework/framework-contract.md" 2>/dev/null || true)
      if [ -n "$ver" ]; then
        echo "  contract:   $ver"
      fi
    fi
    ;;
  help|--help|-h)
    usage
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    echo "lazy: unknown command '$cmd'" >&2
    usage
    exit 1
    ;;
esac
