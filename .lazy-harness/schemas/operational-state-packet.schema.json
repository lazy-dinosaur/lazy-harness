{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://lazy-harness.local/schemas/operational-state-packet.schema.json",
  "title": "OperationalStatePacket",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "taskKind", "requiredReads", "recommendedReads", "capabilities", "evidence", "risk", "notes"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "method", "canonicalInputs", "generatedInputs", "fallbackNeeded"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "enum": ["operational-state-v1"] },
        "canonicalInputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "generatedInputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "fallbackNeeded": { "type": "boolean" }
      }
    },
    "taskKind": { "$ref": "#/definitions/taskKind" },
    "requiredReads": { "type": "array", "items": { "$ref": "#/definitions/readPointer" }, "default": [] },
    "recommendedReads": { "type": "array", "items": { "$ref": "#/definitions/readPointer" }, "default": [] },
    "capabilities": { "type": "array", "items": { "$ref": "#/definitions/capabilityPointer" }, "default": [] },
    "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidencePointer" }, "default": [] },
    "risk": { "$ref": "#/definitions/risk" },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
  },
  "definitions": {
    "taskKind": { "type": "string", "enum": ["unknown", "implementation", "planning", "validation", "recording"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
    "pointerKind": { "type": "string", "enum": ["record", "plan", "project-profile", "source-file", "test", "schema", "fixture", "graph", "template", "directory", "generated-index"] },
    "readPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/definitions/pointerKind" },
        "reason": { "type": "string", "minLength": 1 },
        "featureIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
      }
    },
    "capabilityPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "level", "sourceRecord", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "enum": ["discover", "recommend", "default", "warn", "block"] },
        "sourceRecord": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "checklistPath": { "type": "string" }
      }
    },
    "evidencePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/definitions/pointerKind" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
