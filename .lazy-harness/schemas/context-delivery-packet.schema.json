{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://lazy-harness.local/schemas/context-delivery-packet.schema.json",
  "title": "ContextCandidatePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "mode",
    "queries",
    "candidateHits",
    "fallbackSearches",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "candidate-retrieval"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/query"
      },
      "default": []
    },
    "candidateHits": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/candidateHit"
      },
      "default": []
    },
    "fallbackSearches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  },
  "definitions": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "source"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "user-phrase",
            "llm-supplied",
            "record-link",
            "fallback"
          ]
        }
      }
    },
    "candidateKind": {
      "type": "string",
      "enum": [
        "record",
        "project-profile",
        "graph-edge",
        "source-file",
        "test",
        "schema",
        "generated-index"
      ]
    },
    "candidateHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "matchedQueries",
        "matchedFields"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/definitions/candidateKind"
        },
        "matchedQueries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "matchedFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    }
  }
}
