{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazy-harness.local/schemas/policies.schema.json",
  "title": "Lazy Harness Policy Registry",
  "type": "object",
  "required": [
    "version",
    "policies"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "scope",
          "stage",
          "level",
          "appliesTo",
          "sourceRecord",
          "evidence",
          "promotion",
          "rollback",
          "updateLoop"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "framework-global",
              "host-project",
              "team-policy",
              "adapter"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "turn",
              "edit",
              "commit",
              "push",
              "release",
              "high-risk-mutation"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "discover",
              "recommend",
              "default",
              "warn",
              "block"
            ]
          },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceRecord": {
            "type": "string",
            "minLength": 1
          },
          "capabilityIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "summary"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["record", "validation-output", "user-confirmation", "update-event"]
                },
                "path": {
                  "type": "string"
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "promotion": {
            "type": "object",
            "required": ["requiresConfirmation", "allowedTargetLevels"],
            "properties": {
              "requiresConfirmation": { "type": "boolean" },
              "allowedTargetLevels": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          },
          "rollback": {
            "type": "object",
            "required": ["criteria", "demotionTarget"],
            "properties": {
              "criteria": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "demotionTarget": {
                "type": "string",
                "enum": ["discover", "recommend", "retired"]
              }
            },
            "additionalProperties": true
          },
          "updateLoop": {
            "type": "object",
            "required": ["eventType", "canonicalByPacketAlone"],
            "properties": {
              "eventType": {
                "type": "string",
                "enum": ["policy-candidate", "policy-promotion", "policy-demotion"]
              },
              "canonicalByPacketAlone": { "const": false }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
