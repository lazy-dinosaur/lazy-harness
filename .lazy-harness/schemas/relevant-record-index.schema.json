{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://lazy-harness.local/schemas/relevant-record-index.schema.json",
  "title": "RelevantRecordIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "records"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["root", "method"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "commit": { "type": "string" },
        "method": { "type": "string", "enum": ["markdown-digest", "fallback-heading", "mixed", "manual"] },
        "tool": { "type": "string" }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/definitions/recordEntry" }
    }
  },
  "definitions": {
    "layer": {
      "type": "string",
      "enum": ["DDD", "SDD", "BDD", "TDD", "ADR", "SSOT", "Planning"]
    },
    "scope": {
      "type": "string",
      "enum": ["framework-global", "host-project", "team-policy", "layer-fact", "transient-plan", "jcode-local", "ambiguous"]
    },
    "digestStatus": {
      "type": "string",
      "enum": ["active", "advisory", "deprecated", "reverted", "needs-review"]
    },
    "digestSource": {
      "type": "string",
      "enum": ["rule-digest", "fallback", "manual"]
    },
    "recordEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordPath", "title", "layer", "status", "scope", "digestSource", "appliesWhen", "bullets"],
      "properties": {
        "recordPath": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "layer": { "$ref": "#/definitions/layer" },
        "status": { "$ref": "#/definitions/digestStatus" },
        "scope": { "$ref": "#/definitions/scope" },
        "digestSource": { "$ref": "#/definitions/digestSource" },
        "appliesWhen": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "must": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "mustNot": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "bullets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "maxItems": 5
        },
        "recordCompletion": { "type": "string" },
        "relatedRecords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "tokensEstimate": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": "string" },
        "sourceRange": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startLine": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 }
          }
        },
        "graphIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    }
  }
}
