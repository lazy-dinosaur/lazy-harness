{
  "$schema": "../schemas/capabilities.schema.json",
  "version": 1,
  "capabilities": [
    {
      "id": "bounded-validation-orchestration",
      "kind": "checklist",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/bounded-validation-governor.md",
      "appliesWhen": [
        "choosing_validation_scope",
        "making_validation_claims",
        "closing_non_trivial_work_unit",
        "before_commit_or_sync"
      ],
      "actions": [
        "Do not run validation after each micro-edit",
        "Batch a coherent mutation set before running lazy check",
        "Run focused or affected validation once per changed-behavior batch when needed",
        "Run lazy validate --plan standard once after the final mutation",
        "Reserve direct lazy test for explicit full-regression requests and commit/push/release gates"
      ],
      "checklistPath": ".lazy-harness/spec/platform/bounded-validation-governor.md",
      "description": "Batch coherent mutations before validation, choose the cheapest sufficient checkpoint, and avoid multiplying focused or full test runs within one work unit.",
      "owner": "framework-global",
      "tags": [
        "validation",
        "bounded",
        "edit-loop",
        "full-regression"
      ],
      "policyIds": [
        "bounded-validation-orchestration"
      ]
    },
    {
      "id": "capability-registry-phase1",
      "kind": "command",
      "level": "discover",
      "sourceRecord": ".lazy-harness/ssot/capability-registry.md",
      "appliesWhen": [
        "finding_project_capabilities",
        "inspecting_project_rules"
      ],
      "actions": [
        "lazy capability list",
        "lazy capability resolve",
        "lazy capability candidates",
        "lazy capability audit"
      ],
      "entrypoint": ".lazy-harness/bin/lazy capability",
      "description": "List, resolve, suggest candidates for, and audit registered project/framework capabilities without adding enforcement.",
      "owner": "framework-global",
      "tags": [
        "capability",
        "registry",
        "phase1"
      ]
    },
    {
      "id": "code-organization-review",
      "kind": "checklist",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/code-organization-profile.md",
      "appliesWhen": [
        "creating_source_file",
        "modifying_source_file",
        "reviewing_code_organization",
        "extracting_shared_code"
      ],
      "actions": [
        "Review changed source against COP-01 through COP-05",
        "Keep coherent flow local or extract one explicit shared authority",
        "Record no organization change needed when the changed surface is already coherent"
      ],
      "checklistPath": ".lazy-harness/spec/platform/code-organization-profile.md",
      "description": "Recommend an observe-only review of new or modified source without inferring system architecture or enforcing a folder taxonomy.",
      "owner": "framework-global",
      "tags": [
        "code-organization",
        "changed-source",
        "review",
        "observe-only"
      ],
      "policyIds": [
        "code-organization-profile"
      ]
    },
    {
      "id": "lazy-evidence-capsule",
      "kind": "checklist",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/evidence-capsule-standard.md",
      "appliesWhen": [
        "closing_non_trivial_work_unit",
        "making_validation_claims",
        "recording_reproducible_evidence",
        "before_commit_with_external_evidence"
      ],
      "actions": [
        "Review evidence capsule checklist",
        "Copy .lazy-harness/templates/evidence-capsule.md when durable evidence is needed"
      ],
      "checklistPath": ".lazy-harness/templates/evidence-capsule.md",
      "description": "Recommend a manual evidence capsule for non-trivial validation, benchmark, visual, migration, dogfood, or phase-closure claims without adding automatic evidence writing.",
      "owner": "framework-global",
      "tags": [
        "evidence",
        "validation",
        "checklist",
        "phase5"
      ],
      "policyIds": [
        "record-first-validation"
      ]
    },
    {
      "id": "project-operating-rulebook",
      "kind": "command",
      "level": "discover",
      "sourceRecord": ".lazy-harness/rules/README.md",
      "rulebookRecord": ".lazy-harness/rules/README.md",
      "appliesWhen": [
        "adding_project_operating_policy",
        "resolving_project_operating_rule",
        "inspecting_project_rules",
        "distinguishing_project_facts_from_operating_rules"
      ],
      "actions": [
        "lazy rules list",
        "lazy rules resolve",
        "lazy rules audit"
      ],
      "entrypoint": ".lazy-harness/bin/lazy rules",
      "description": "List, audit, and resolve project operating rulebook entries separately from project fact records.",
      "owner": "framework-global",
      "tags": [
        "rules",
        "rulebook",
        "capability",
        "phase0-2"
      ],
      "preferredActions": [
        ".lazy-harness/rules/**",
        ".lazy-harness/bin/lazy rules",
        ".lazy-harness/ssot/capabilities.json"
      ],
      "discouragedActions": [
        "runtime-local transport file as project policy body",
        "runtime or personal memory as project/team policy authority"
      ],
      "requiresReasonForBypass": false,
      "policyIds": [
        "project-operating-rulebook-policy"
      ]
    }
  ]
}
