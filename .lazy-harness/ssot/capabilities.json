{
  "$schema": "../schemas/capabilities.schema.json",
  "version": 1,
  "capabilities": [
    {
      "id": "capability-registry-phase1",
      "kind": "command",
      "level": "discover",
      "sourceRecord": ".lazy-harness/ssot/capability-registry.md",
      "appliesWhen": [
        "finding_project_capabilities",
        "inspecting_project_rules"
      ],
      "actions": [
        "lazy capability list",
        "lazy capability resolve",
        "lazy capability candidates",
        "lazy capability audit"
      ],
      "entrypoint": ".lazy-harness/bin/lazy capability",
      "description": "List, resolve, suggest candidates for, and audit registered project/framework capabilities without adding enforcement.",
      "owner": "framework-global",
      "tags": [
        "capability",
        "registry",
        "phase1"
      ]
    },
    {
      "id": "lazy-evidence-capsule",
      "kind": "checklist",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/evidence-capsule-standard.md",
      "appliesWhen": [
        "closing_non_trivial_work_unit",
        "making_validation_claims",
        "recording_reproducible_evidence",
        "before_commit_with_external_evidence"
      ],
      "actions": [
        "Review evidence capsule checklist",
        "Copy .lazy-harness/templates/evidence-capsule.md when durable evidence is needed"
      ],
      "checklistPath": ".lazy-harness/templates/evidence-capsule.md",
      "description": "Recommend a manual evidence capsule for non-trivial validation, benchmark, visual, migration, dogfood, or phase-closure claims without adding automatic evidence writing.",
      "owner": "framework-global",
      "tags": [
        "evidence",
        "validation",
        "checklist",
        "phase5"
      ],
      "policyIds": [
        "record-first-validation"
      ]
    },
    {
      "id": "project-operating-rulebook",
      "kind": "command",
      "level": "discover",
      "sourceRecord": ".lazy-harness/rules/README.md",
      "rulebookRecord": ".lazy-harness/rules/README.md",
      "appliesWhen": [
        "adding_project_operating_policy",
        "resolving_project_operating_rule",
        "inspecting_project_rules",
        "distinguishing_project_facts_from_operating_rules"
      ],
      "actions": [
        "lazy rules list",
        "lazy rules resolve",
        "lazy rules audit"
      ],
      "entrypoint": ".lazy-harness/bin/lazy rules",
      "description": "List, audit, and resolve project operating rulebook entries separately from project fact records.",
      "owner": "framework-global",
      "tags": [
        "rules",
        "rulebook",
        "capability",
        "phase0-2"
      ],
      "preferredActions": [
        ".lazy-harness/rules/**",
        ".lazy-harness/bin/lazy rules",
        ".lazy-harness/ssot/capabilities.json"
      ],
      "discouragedActions": [
        ".jcode/harness/20-project-rules.md project policy body",
        "Jcode memory project/team rule body"
      ],
      "requiresReasonForBypass": false,
      "policyIds": [
        "project-operating-rulebook-policy"
      ]
    },
    {
      "id": "retrieval-purpose-architecture",
      "kind": "command",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/purpose-scoped-retrieval.md",
      "appliesWhen": [
        "retrieval_architecture",
        "planning_architecture_change",
        "retrieval_full"
      ],
      "actions": [
        "lazy find --purpose architecture",
        "lazy find --purpose full"
      ],
      "entrypoint": ".lazy-harness/bin/lazy find --purpose architecture",
      "description": "Use architecture/full purpose retrieval for broad design/change work with layer completeness cues.",
      "owner": "framework-global",
      "tags": [
        "retrieval",
        "purpose",
        "architecture",
        "full"
      ]
    },
    {
      "id": "retrieval-purpose-fact",
      "kind": "command",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/purpose-scoped-retrieval.md",
      "appliesWhen": [
        "retrieval_fact",
        "retrieval_record",
        "finding_project_facts"
      ],
      "actions": [
        "lazy find --purpose fact",
        "lazy find --purpose record"
      ],
      "entrypoint": ".lazy-harness/bin/lazy find --purpose fact",
      "description": "Use fact/record purpose retrieval for project facts, contracts, implementation truth, and source-of-truth questions.",
      "owner": "framework-global",
      "tags": [
        "retrieval",
        "purpose",
        "fact"
      ]
    },
    {
      "id": "retrieval-purpose-rulebook",
      "kind": "command",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/purpose-scoped-retrieval.md",
      "appliesWhen": [
        "retrieval_rulebook",
        "retrieval_operating_rule",
        "finding_project_operating_rules"
      ],
      "actions": [
        "lazy find --purpose rulebook"
      ],
      "preferredActions": [
        "lazy find --purpose rulebook",
        "lazy rules resolve",
        "lazy capability resolve"
      ],
      "entrypoint": ".lazy-harness/bin/lazy find --purpose rulebook",
      "description": "Use rulebook purpose retrieval for project operating rules and action policy before broad fact records.",
      "owner": "framework-global",
      "tags": [
        "retrieval",
        "purpose",
        "rulebook"
      ]
    },
    {
      "id": "retrieval-purpose-source",
      "kind": "command",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/purpose-scoped-retrieval.md",
      "appliesWhen": [
        "retrieval_source",
        "finding_implementation"
      ],
      "actions": [
        "lazy find --purpose source"
      ],
      "entrypoint": ".lazy-harness/bin/lazy find --purpose source",
      "description": "Use source purpose retrieval to find implementation/source candidates before widening to contracts.",
      "owner": "framework-global",
      "tags": [
        "retrieval",
        "purpose",
        "source"
      ]
    },
    {
      "id": "retrieval-purpose-test",
      "kind": "command",
      "level": "recommend",
      "sourceRecord": ".lazy-harness/spec/platform/purpose-scoped-retrieval.md",
      "appliesWhen": [
        "retrieval_test",
        "retrieval_validation",
        "finding_tests"
      ],
      "actions": [
        "lazy find --purpose test",
        "lazy find --purpose validation"
      ],
      "entrypoint": ".lazy-harness/bin/lazy find --purpose test",
      "description": "Use test purpose retrieval for TDD/source-test/validation capability surfaces before widening to records.",
      "owner": "framework-global",
      "tags": [
        "retrieval",
        "purpose",
        "test",
        "validation"
      ]
    }
  ]
}
