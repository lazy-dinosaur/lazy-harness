{
  "schemaVersion": "policy-machinery-v2/v1",
  "id": "record-first-validation",
  "title": "Record-first validation evidence",
  "scope": "framework-global",
  "stage": "turn",
  "level": "discover",
  "appliesTo": [
    "closing_non_trivial_work_unit",
    "making_validation_claims"
  ],
  "sourceRecord": ".lazy-harness/spec/platform/policy-machinery-v2.md",
  "capabilityIds": [
    "lazy-evidence-capsule"
  ],
  "evidence": [
    {
      "kind": "record",
      "path": ".lazy-harness/spec/platform/evidence-capsule-standard.md",
      "summary": "Existing evidence capsule capability is recommend-level and manual."
    },
    {
      "kind": "update-event",
      "path": ".lazy-harness/spec/platform/project-map-update-loop-v2.md",
      "summary": "Policy changes must use update-loop candidate/canonical transition semantics."
    }
  ],
  "promotion": {
    "requiresConfirmation": true,
    "allowedTargetLevels": [
      "discover",
      "recommend"
    ]
  },
  "rollback": {
    "criteria": [
      "Evidence capsule recommendation becomes noisy or not useful in dogfood validation.",
      "A stronger level is requested without user/team confirmation."
    ],
    "demotionTarget": "discover"
  },
  "updateLoop": {
    "eventType": "policy-candidate",
    "canonicalByPacketAlone": false
  },
  "explain": {
    "summary": "Before claiming validation is complete, attach or summarize concrete validation evidence from canonical records/tests.",
    "nonCanonicalViews": [
      ".lazy-harness/rules/README.md"
    ]
  },
  "storageDecision": {
    "current": "typed-policy-canonical-plus-capability-bindings",
    "rulebookMarkdown": "compatibility-generated-explain-view",
    "requiresOptionGateBeforeMigration": false,
    "selectedBy": "user-confirmed-option-b"
  }
}
