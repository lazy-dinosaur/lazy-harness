<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lazy-Harness Skills Manifest
  Single source of truth for which skills exist and their lifecycle status.

  Schema: each <skill> has id, location, status, phase, dependsOn (optional).
  status values: stable | beta | deferred | retired
-->
  <skillsManifest version="1" updatedAt="2026-05-12T10:51:00Z">

  <!-- Jcode skills are optional wrappers. ADR 0022: framework logic lives in .lazy-harness. -->
  <skill id="harness-init" status="retired" phase="5a" replacedBy="standalone lazy-harness extract">
    <location>.jcode/skills/harness-init/</location>
    <description>Retired Jcode wrapper concept. Future init belongs to standalone lazy-harness.</description>
    <slashCommand>/harness-init</slashCommand>
    <emitsLogs>true</emitsLogs>
  </skill>

  <skill id="lazy-test" status="stable" phase="5c">
    <location>.lazy-harness/scripts/self-test.py</location>
    <description>Framework-owned reproducible self-test: XML, JSONL, trigger fixtures, interview loop, affected test runner</description>
    <command>bun run lazy:test</command>
    <emitsLogs>true</emitsLogs>
  </skill>

  <skill id="lazy-doctor" status="stable" phase="5c">
    <location>.lazy-harness/scripts/doctor.py</location>
    <description>Framework-owned health/audit doctor for XML, JSONL, ADR/docs freshness, branch policy, external dependency invariant, and package health</description>
    <command>bun run lazy:doctor</command>
    <command>python3 .lazy-harness/scripts/doctor.py --profile smoke</command>
    <command>python3 .lazy-harness/scripts/doctor.py --profile full</command>
    <emitsLogs>true</emitsLogs>
  </skill>

  <skill id="lazy-layer-impact-gate" status="alpha" phase="N1">
    <location>.lazy-harness/scripts/layer-impact-gate.ts</location>
    <description>N1 — Layer Impact Completion Gate (north-star priority A). For a given changed-file set, decide which of DDD/SDD/BDD/TDD/ADR record layers are impacted vs updated and emit a Unified Result Schema document conforming to schemas/layer-impact-result.schema.json. Heuristic-only v0 (resolverVersion=null) until N2 reference resolver lands.</description>
    <command>bun .lazy-harness/scripts/layer-impact-gate.ts --file &lt;path&gt; [--file ...]</command>
    <command>bun .lazy-harness/scripts/layer-impact-gate.ts --from HEAD~1 --to HEAD --append-validation</command>
    <emitsLogs>true</emitsLogs>
    <ownsArtifacts>.lazy-harness/schemas/layer-impact-result.schema.json</ownsArtifacts>
    <ownsArtifacts>.lazy-harness/triggers/fixtures/layer-impact/*.json</ownsArtifacts>
  </skill>

  <!-- DDD/SDD/BDD/TDD/ADR are core record layers, not automatically separate skills.
       Promote a layer-specific skill only when repeated real host-project use proves
       a concrete workflow, command, and artifact contract. -->

  <skill id="lazy-interview" status="stable" phase="5d">
    <location>.lazy-harness/scripts/interview-loop.ts</location>
    <description>Structured question collection and answer persistence: trigger/cross-layer gap → A/B/C/D options → decisions.jsonl</description>
    <command>bun .lazy-harness/scripts/interview-loop.ts --mode collect</command>
    <command>bun .lazy-harness/scripts/interview-loop.ts --mode answer --apply</command>
    <emitsLogs>true</emitsLogs>
    <ownsArtifacts>.lazy-harness/questions/open.xml</ownsArtifacts>
    <ownsArtifacts>.lazy-harness/logs/decisions.jsonl</ownsArtifacts>
  </skill>

  <skill id="lazy-affected-test" status="stable" phase="5d">
    <location>.lazy-harness/scripts/affected-test-runner.ts</location>
    <description>Find matching affected tests and run them through project-owned test strategy or package scripts; create structured TDD questions when missing</description>
    <command>bun run lazy:test:affected -- --files &lt;changed-file&gt;</command>
    <emitsLogs>true</emitsLogs>
    <dependsOn>lazy-interview</dependsOn>
  </skill>

  <skill id="lazy-project-profile" status="planned" phase="5e">
    <location>.lazy-harness/plans/project-init-interview-spec.md</location>
    <description>Skill-first project profile flow: capture project purpose, folder structure, frontend/backend architecture, design system, test strategy, and agent rules before feature work</description>
    <futureCommand>bun .lazy-harness/scripts/project-profile.ts --mode inspect</futureCommand>
    <futureCommand>bun .lazy-harness/scripts/project-profile.ts --mode interview --apply</futureCommand>
    <emitsLogs>true</emitsLogs>
    <dependsOn>lazy-interview</dependsOn>
  </skill>

  <skill id="lazy-report" status="planned" phase="post-5e">
    <location>.lazy-harness/plans/report-and-knowledge-roadmap.md</location>
    <description>Export host-project usage evidence as copy/pasteable Markdown plus future-ingestable JSON for framework improvement</description>
    <futureCommand>bun run lazy:report</futureCommand>
    <emitsLogs>true</emitsLogs>
    <dependsOn>lazy-project-profile</dependsOn>
    <dependsOn>lazy-doctor</dependsOn>
  </skill>

  <skill id="harness-update" status="retired" phase="5a" replacedBy="standalone lazy-harness extract">
    <location>.jcode/skills/harness-update/</location>
    <description>Retired Jcode wrapper concept. Future update belongs to standalone lazy-harness.</description>
    <slashCommand>/harness-update</slashCommand>
    <emitsLogs>true</emitsLogs>
    <dependsOn>lazy-test</dependsOn>
  </skill>

  <!-- Phase 5b: 3 hooks (sh, no skill UI yet) -->
  <skill id="post-commit-logger" status="stable" phase="5b">
    <location>.lazy-harness/hooks/post-commit.sh</location>
    <description>Append commit metadata to logs/actions.jsonl + suggest regression candidate on Fix:</description>
    <wiredAt>.git/hooks/post-commit (delegate)</wiredAt>
    <emitsLogs>true</emitsLogs>
  </skill>

  <skill id="pre-push-validator" status="stable" phase="5b">
    <location>.lazy-harness/hooks/pre-push.sh</location>
    <description>Block push if lazy:test fails or private files leaked; emit Unified Result Schema</description>
    <wiredAt>.git/hooks/pre-push (delegate)</wiredAt>
    <emitsLogs>true</emitsLogs>
    <dependsOn>lazy-test</dependsOn>
  </skill>

  <skill id="weekly-snapshot" status="stable" phase="5b">
    <location>.lazy-harness/hooks/weekly-snapshot.sh</location>
    <description>rsync .lazy-harness/ → .lazy-harness-backup/ISO-week/ (manual or cron)</description>
    <wiredAt>cron (user installs manually): 0 18 * * 5</wiredAt>
    <retention>last 8 weeks auto-pruned</retention>
  </skill>

  <!-- Phase 5b deferred -->
  <skill id="contract-diff-ast" status="deferred" phase="5b-2a"
         deferReason="ADR 0008 — measure first; ts-morph adoption gated on 1-week real usage data">
    <location>.lazy-harness/scripts/contract-diff.ts (skeleton only)</location>
    <description>ts-morph based contract drift detection</description>
    <decisionDoc>.lazy-harness/decisions/0008-ast-contract-diff-deferred.md</decisionDoc>
  </skill>

  <skill id="regression-detect" status="beta" phase="5b">
    <location>.lazy-harness/hooks/post-commit.sh (inline)</location>
    <description>Auto-suggest regression candidates on Fix: commits</description>
    <currentBehavior>Append to regression/candidates.jsonl; human promotes manually</currentBehavior>
    <futureWork>Auto-extract symbol from Fix: subject + scan for tests covering it (5c)</futureWork>
  </skill>

  <!-- External source-specific adapters were intentionally removed from the roadmap.
