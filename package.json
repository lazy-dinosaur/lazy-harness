{
  "name": "lazy-harness",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.5.0",
    "ts-morph": "28.0.0",
    "typebox": "1.3.7",
    "typescript": "6.0.3"
  },
  "scripts": {
    "test:run": "sh -c 'bun test \"$@\" && echo \"1 passed\"' --",
    "build:node": "bun build .lazy-harness/scripts/*.ts --target=bun --outdir \"$(mktemp -d)\" > /dev/null",
    "typecheck:node": "bun run typecheck:bun",
    "typecheck:bun": "bun node_modules/typescript/bin/tsc --noEmit --target esnext --module preserve --moduleResolution bundler --allowImportingTsExtensions --types node,bun .lazy-harness/scripts/*.ts"
  }
}
